# WageGuard environment variables — copy to .env for local development.
# NEVER commit real values. The .env file is in .gitignore.

# --- Database (local Postgres+pgvector via compose.yaml) -------------------
WAGEGUARD_DATABASE_URL=postgresql+psycopg://wageguard:wageguard@localhost:5432/wageguard
WAGEGUARD_DATABASE_ADMIN_URL=postgresql+psycopg://wageguard_admin:wageguard_admin@localhost:5432/wageguard

# --- Application mode ------------------------------------------------------
# synthetic  -> stores full input snapshots and raw model output
# hash_only  -> stores input hashes and redacted model output
WAGEGUARD_PRIVACY_MODE=synthetic
WAGEGUARD_APP_ENV=dev

# --- LLM provider ----------------------------------------------------------
# Provider-agnostic port. Development adapters are Gemini and Groq.
# Set exactly one provider; the model ID is pinned (never an alias).
WAGEGUARD_LLM_PROVIDER=gemini               # gemini | groq | cassette | fake
WAGEGUARD_LLM_MODEL_ID=                     # e.g. gemini-2.5-flash-002 / llama-3.3-70b-versatile
WAGEGUARD_LLM_TIMEOUT_SECONDS=30
WAGEGUARD_LLM_MAX_TOKENS=1024

GEMINI_API_KEY=
GROQ_API_KEY=

# --- Embeddings ------------------------------------------------------------
# Embedding model is pinned and recorded in the ledger. A test fake is used
# in unit/property tests; integration tests use the real model (recorded).
WAGEGUARD_EMBEDDING_PROVIDER=fake           # fake | gemini | <other>
WAGEGUARD_EMBEDDING_MODEL_ID=
WAGEGUARD_EMBEDDING_DIMENSION=384

# --- API server ------------------------------------------------------------
WAGEGUARD_API_HOST=127.0.0.1
WAGEGUARD_API_PORT=8080
# Comma-separated API keys with role prefix, e.g. "checker:xxx,auditor:yyy,admin:zzz".
# Keys are compared in constant time and hashed at rest.
WAGEGUARD_API_KEYS=

# --- Observability ---------------------------------------------------------
WAGEGUARD_LOG_LEVEL=INFO
WAGEGUARD_LOG_FORMAT=json
